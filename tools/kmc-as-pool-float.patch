    $at (the game units); the ROM's libultra objects were assembled by an
    upstream-style gas that reuses rd (--lw-dest-temp clears this).  */
 int kmc_at_index = 1;
+/* KMC: the game objects never build a float literal in $at: `li.s $fN,c'
+   with c != 0 is a load from a pool in .rodata, `lui $at,%hi(pool); lwc1
+   $fN,%lo(pool)($at)' (2702 pool loads in the ROM's game code whose value
+   has a zero low half, 1.0 alone at 391 different addresses, and not one
+   `lui $at; mtc1 $at,$fN'), where stock gas with -G0 makes `lui $at,c >> 16;
+   mtc1 $at,$fN' (and `lui; ori; mtc1').  The libultra objects do have the
+   lui/mtc1 form (45 + 3 sites) and keep it.  -1 follows
+   --no-float-doubleword, which only the game units pass;
+   --pool-float-literals / --no-pool-float-literals set it.  */
+int kmc_pool_floats = -1;
+#define KMC_POOL_FLOATS \
+  (kmc_pool_floats < 0 ? no_float_doubleword : kmc_pool_floats)
 /* KMC: the ROM's assembler never leaves a float multiply in a branch delay
    slot: it moves the multiply in front of the branch and puts a nop in the
    slot (45 slots in our build, 0 in the ROM).  Not for the libultra unit
@@ -3915,6 +3927,21 @@ macro (ip)
